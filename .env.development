# AixG Local Development Environment Configuration

# Application
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3001

# Database
DATABASE_URL="postgresql://aixg_user:aixg_password@localhost:5432/aixg_development"
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Services
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
COHERE_API_KEY=your-cohere-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Vector Database
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX_NAME=aixg-tactical-knowledge

# Video Processing
FFMPEG_PATH=/usr/local/bin/ffmpeg
VIDEO_STORAGE_PATH=./storage/videos
MAX_VIDEO_SIZE_MB=500

# Hebrew NLP
HEBREW_NLP_MODEL_PATH=./models/hebrew-nlp
HEBREW_MORPHOLOGY_ENABLED=true

# Monitoring & Logging
LOG_LEVEL=debug
ENABLE_QUERY_LOGGING=true
SENTRY_DSN=your-sentry-dsn-optional

# Frontend Development
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_ENV=development

# Development Tools
ENABLE_SWAGGER=true
ENABLE_GRAPHQL_PLAYGROUND=true
ENABLE_HOT_RELOAD=true
CORS_ORIGIN=http://localhost:3000