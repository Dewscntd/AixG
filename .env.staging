# AixG Staging Environment Configuration

# Application
NODE_ENV=staging
PORT=3001
API_URL=https://staging-api.aixg.football

# Database
DATABASE_URL="postgresql://aixg_staging:secure_staging_password@staging-db:5432/aixg_staging"
REDIS_URL="redis://staging-redis:6379"

# Authentication & Security
JWT_SECRET=staging-jwt-secret-secure-key-here
JWT_REFRESH_SECRET=staging-jwt-refresh-secret-secure-key-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Services
OPENAI_API_KEY=${OPENAI_API_KEY}
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
COHERE_API_KEY=${COHERE_API_KEY}
GOOGLE_AI_API_KEY=${GOOGLE_AI_API_KEY}

# Vector Database
PINECONE_API_KEY=${PINECONE_API_KEY}
PINECONE_ENVIRONMENT=staging
PINECONE_INDEX_NAME=aixg-tactical-knowledge-staging

# Video Processing
FFMPEG_PATH=/usr/bin/ffmpeg
VIDEO_STORAGE_PATH=/app/storage/videos
MAX_VIDEO_SIZE_MB=1000

# Object Storage (S3 Compatible)
S3_ENDPOINT=https://staging-minio.aixg.football
S3_ACCESS_KEY_ID=${S3_ACCESS_KEY_ID}
S3_SECRET_ACCESS_KEY=${S3_SECRET_ACCESS_KEY}
S3_BUCKET_NAME=aixg-staging

# Hebrew NLP
HEBREW_NLP_MODEL_PATH=/app/models/hebrew-nlp
HEBREW_MORPHOLOGY_ENABLED=true

# Monitoring & Logging
LOG_LEVEL=info
ENABLE_QUERY_LOGGING=false
SENTRY_DSN=${SENTRY_DSN}

# Frontend
NEXT_PUBLIC_API_URL=https://staging-api.aixg.football
NEXT_PUBLIC_WS_URL=wss://staging-api.aixg.football
NEXT_PUBLIC_ENV=staging

# Security
CORS_ORIGIN=https://staging.aixg.football
ENABLE_SWAGGER=false
ENABLE_GRAPHQL_PLAYGROUND=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Performance
ENABLE_COMPRESSION=true
ENABLE_CACHING=true
CACHE_TTL=300